# Copy to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/yourfleet_dev
JWT_SECRET=CHANGE_ME_generate_a_long_random_string
JWT_EXPIRES_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
# Optional: enables `python -m app.cli enrich-google` (Places API New, Text Search)
GOOGLE_PLACES_API_KEY=
